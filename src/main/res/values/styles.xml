<?xml version="1.0" encoding="utf-8"?>
<!-- Binnacle theme. Colours come from the token files (values/colors.xml for
     light, values-night/colors.xml for dark). Type faces from res/font. -->
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bin_panel</item>
        <item name="colorPrimaryDark">@color/bin_ink</item>
        <item name="colorAccent">@color/bin_now</item>
        <item name="android:windowBackground">@color/bin_ink</item>
        <item name="android:colorBackground">@color/bin_ink</item>
        <item name="android:textColorPrimary">@color/bin_text</item>
        <item name="android:textColorSecondary">@color/bin_muted</item>
        <item name="android:statusBarColor">@color/bin_ink</item>
        <item name="android:navigationBarColor">@color/bin_ink</item>
        <item name="android:windowLightStatusBar">@bool/bin_light_status</item>
        <item name="android:fontFamily">@font/bin_ui</item>
        <item name="fontFamily">@font/bin_ui</item>
    </style>

    <style name="PreferencesTheme" parent="Theme.AppCompat.DayNight">
        <item name="colorPrimary">@color/bin_panel</item>
        <item name="colorPrimaryDark">@color/bin_ink</item>
        <item name="colorAccent">@color/bin_now</item>
        <item name="android:windowBackground">@color/bin_ink</item>
        <item name="android:colorBackground">@color/bin_ink</item>
        <item name="android:textColorPrimary">@color/bin_text</item>
        <item name="android:textColorSecondary">@color/bin_muted</item>
        <item name="android:statusBarColor">@color/bin_ink</item>
        <item name="android:windowLightStatusBar">@bool/bin_light_status</item>
        <item name="android:fontFamily">@font/bin_ui</item>
        <item name="fontFamily">@font/bin_ui</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <!-- Toolbar sits on the ink surface. -->
    <style name="Widget.MyApp.Toolbar.Solid" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/bin_ink</item>
    </style>

    <style name="ThemeOverlay.MyApp.ActionBar" parent="ThemeOverlay.AppCompat.ActionBar">
        <item name="android:textColorPrimary">@color/bin_text</item>
        <item name="colorControlNormal">@color/bin_muted</item>
    </style>

    <!-- App name / toolbar title uses the display face. -->
    <style name="TextAppearance.Binnacle.Toolbar.Title" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:fontFamily">@font/bin_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/bin_text</item>
    </style>

</resources>
