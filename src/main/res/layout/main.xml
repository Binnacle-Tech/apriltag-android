<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@mipmap/april_lab"
            android:paddingLeft="10dp"
            android:contentDescription="@string/app_name"
            android:theme="@style/Widget.MyApp.Toolbar.Solid"/>
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:theme="@style/ThemeOverlay.MyApp.ActionBar"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Dark"
            style="@style/Widget.MyApp.Toolbar.Solid"
            android:elevation="4dp">

            <!-- Custom title so the display face (Space Grotesk) applies on all
                 API levels; app:fontFamily is honored by AppCompat down to 21. -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/toolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/app_name"
                android:textColor="@color/bin_text"
                android:textSize="20sp"
                android:textStyle="bold"
                app:fontFamily="@font/bin_display" />
        </androidx.appcompat.widget.Toolbar>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/previewPane"
        android:layout_width="match_parent"
        android:layout_height="match_parent" >

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="compatible"
            app:scaleType="fitCenter" />

        <TextureView
            android:id="@+id/tagView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:rotation="0" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Telemetry well: machine data in the mono face, in a recessed panel
                 ("show the work"). Shown only when diagnostics are enabled. -->
            <LinearLayout
                android:id="@+id/telemetryWell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bin_well_panel"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/previewFpsTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bin_mono"
                    android:textColor="@color/bin_text"
                    android:textSize="12sp"
                    android:text="N/A fps" />

                <TextView
                    android:id="@+id/detectionFpsTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/bin_mono"
                    android:textColor="@color/bin_text"
                    android:textSize="12sp"
                    android:text="N/A fps" />
            </LinearLayout>

            <!-- Tag-family status pill: an eyebrow label, tracked and uppercased. -->
            <TextView
                android:id="@+id/tagFamily"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bin_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:fontFamily="@font/bin_ui"
                android:textColor="@color/bin_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:text="tag36h11" />
        </LinearLayout>

        <!-- Stop state: shown when camera access is blocked or the camera fails to
             open. Fail loud, gate clearly. -->
        <LinearLayout
            android:id="@+id/stopState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bin_ink"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bin_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_bin_failed"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/stopStateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/bin_display"
                    android:textStyle="bold"
                    android:textColor="@color/bin_text"
                    android:textSize="18sp"
                    android:text="Camera unavailable" />

                <TextView
                    android:id="@+id/stopStateMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxWidth="300dp"
                    android:textColor="@color/bin_muted"
                    android:textSize="14sp"
                    android:text="Camera access is needed to detect AprilTags." />

                <Button
                    android:id="@+id/stopStateButton"
                    style="@style/Widget.AppCompat.Button.Colored"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/bin_on_now"
                    android:text="Grant camera access" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
